; Engine configuration file.
; Mission 2050 native mobile edition. No WebView, JavaScript or network dependency.
config_version=5

[application]
config/name="Mission 2050 - Aakhri Saans"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/description="An offline third-person climate adventure."\nrun/low_processor_mode=false

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/handheld/orientation=6

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.56, 0.69, 0.77, 1)

[physics]
3d/default_gravity=24.0

